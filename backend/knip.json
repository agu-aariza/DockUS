{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/main.ts",
    "src/worker.ts",
    "src/shared/infrastructure/database/data-source.ts",
    "src/shared/infrastructure/database/migrations/*.ts",
    "test/unit/**/*.spec.ts"
  ],
  "project": [
    "src/**/*.ts",
    "test/**/*.ts"
  ],
  "paths": {
    "@app/*": ["src/*"],
    "@test/*": ["test/*"]
  },
  "ignoreExportsUsedInFile": true,
  "ignoreDependencies": [
    "pino-pretty"
  ],
  "ignoreIssues": {
    "src/modules/health/health.service.ts": [
      "types"
    ]
  }
}
