# syntax=docker/dockerfile:1

# Production multi-stage image for the DockUS backend.

# --- Stage 1: dependencies ---------------------------------------------------
FROM node:22.12.0-alpine3.21 AS deps
WORKDIR /app
COPY backend/package*.json ./
# Shared types package is referenced as file:../shared/contracts from backend/package.json.
# With WORKDIR /app, npm resolves that to /shared/contracts inside the container.
COPY shared/contracts /shared/contracts
RUN npm ci

# --- Stage 2: build ----------------------------------------------------------
FROM node:22.12.0-alpine3.21 AS build
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
# Keep the @dockus/contracts symlink target valid for the build stage.
COPY --from=deps /shared/contracts /shared/contracts
COPY backend/ ./
RUN npm run build && npm prune --production

# --- Stage 3: production runtime ---------------------------------------------
FROM node:22.12.0-alpine3.21 AS production

# Tools required by the builder pipeline (Docker CLI and Python helpers).
RUN apk add --no-cache \
    docker-cli \
    docker-cli-buildx \
    curl \
    python3

# Non-root user/group aligned with docker-patterns best practices.
RUN addgroup -g 1001 -S appgroup \
  && adduser -S appuser -u 1001 -G appgroup \
  && mkdir -p /app && chown -R appuser:appgroup /app

WORKDIR /app
USER appuser

COPY --from=build --chown=appuser:appgroup /app/package*.json ./
COPY --from=build --chown=appuser:appgroup /app/node_modules ./node_modules
COPY --from=build --chown=appuser:appgroup /app/dist ./dist
# @dockus/contracts is types-only, but keep its symlink target valid in the final image.
COPY --from=build --chown=appuser:appgroup /shared/contracts /shared/contracts

ENV NODE_ENV=production
EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=5 \
  CMD wget -qO- http://localhost:3000/api/health/live || exit 1

CMD ["node", "dist/main"]
