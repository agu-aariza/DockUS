# syntax=docker/dockerfile:1

# Development image for the DockUS backend.
# Intentionally runs as root because it bind-mounts the host source tree and
# requires access to the host Docker socket for the builder pipeline.
FROM node:22-alpine AS dev

RUN apk add --no-cache \
    docker-cli \
    docker-cli-buildx \
    curl \
    python3

WORKDIR /app

# Shared types package is referenced as file:../shared/contracts from backend/package.json.
# With WORKDIR /app, npm resolves that to /shared/contracts inside the container.
COPY shared/contracts /shared/contracts

EXPOSE 3000

HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=5 \
  CMD wget -qO- http://localhost:3000/api/health/live || exit 1

CMD ["npm", "run", "start:dev"]
