# ==========================================
# DOCKUS - ENVIRONMENT CONFIGURATION
# ==========================================

# ==========================================
# CONFIGURACION DE LA APLICACION (NestJS)
# ==========================================
NODE_ENV=development
PORT=3000

# ==========================================
# BASE DE DATOS (PostgreSQL)
# ==========================================
# Variables consumidas por backend/src/app.module.ts
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=dockus
DB_PASSWORD=dockus_secure_pass
DB_NAME=dockus_db

# Puerto publicado por Docker Compose
POSTGRES_PORT=5432

# URL de conexion para TypeORM (Backend)
DATABASE_URL=postgresql://${DB_USERNAME}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# ==========================================
# CACHE (Redis)
# ==========================================
REDIS_HOST=localhost
REDIS_PORT=6379

# ==========================================
# SEGURIDAD (JWT)
# ==========================================
JWT_SECRET=reemplazar_por_un_secreto_seguro_en_produccion
JWT_EXPIRES_IN=7d

# ==========================================
# ALMACENAMIENTO DE ARCHIVOS (MinIO)
# ==========================================
MINIO_ROOT_USER=dockus_admin
MINIO_ROOT_PASSWORD=dockus_secret_key
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=localhost
