# ==========================================
# DOCKUS - ENVIRONMENT CONFIGURATION
# ==========================================

# ==========================================
# CONFIGURACION DE LA APLICACION (NestJS)
# ==========================================
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# ==========================================
# BASE DE DATOS (PostgreSQL)
# ==========================================
# Variables consumidas por backend/src/shared/infrastructure
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=dockus
DB_PASSWORD=tu_password_aqui
DB_NAME=dockus_db

# Puerto publicado por Docker Compose
POSTGRES_PORT=5432

# URL de conexion para TypeORM (Backend)
DATABASE_URL=postgresql://${DB_USERNAME}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# ==========================================
# CACHE (Redis)
# ==========================================
REDIS_HOST=localhost
REDIS_PORT=6379

# ==========================================
# SEGURIDAD (JWT)
# ==========================================
JWT_SECRET=tu_secreto_jwt_seguro
JWT_EXPIRES_IN=1d

# ==========================================
# ALMACENAMIENTO DE ARCHIVOS (MinIO)
# ==========================================
MINIO_ROOT_USER=dockus_admin
MINIO_ROOT_PASSWORD=tu_password_aqui
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=localhost
