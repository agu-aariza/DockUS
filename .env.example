# ==============================================================================
# DOCKUS - CONFIGURACIÓN DE ENTORNO (PROYECTO ACADÉMICO LLM-FIRST)
# ==============================================================================
# Este archivo sirve como base para configurar DockUS. 
# Copia este archivo a `.env` y ajusta los valores según tu entorno local.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APLICACIÓN Y FRONTEND
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# Base URL para que el frontend (Vite) consuma la API
VITE_API_BASE_URL=http://localhost:3000/api

# ------------------------------------------------------------------------------
# 2. BASE DE DATOS (PostgreSQL)
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=dockus
DB_PASSWORD=dockus_secure_pass
DB_NAME=dockus_db

# URL completa consumida por Prisma/TypeORM si fuera necesario (opcional)
DATABASE_URL=postgresql://${DB_USERNAME}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# ------------------------------------------------------------------------------
# 3. CACHE Y COLAS (Redis)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# 4. AUTENTICACIÓN (JWT)
# ------------------------------------------------------------------------------
# IMPORTANTE: Cambiar estas claves en entornos de producción
JWT_SECRET=dockus_example_jwt_secret_replace_before_prod_2026
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dockus_example_refresh_secret_replace_before_prod_2026
JWT_REFRESH_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 5. ALMACENAMIENTO DE OBJETOS (MinIO / S3)
# ------------------------------------------------------------------------------
MINIO_ENDPOINT=localhost
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=dockus_admin
MINIO_ROOT_PASSWORD=dockus_secret_key
MINIO_BUCKET_NAME=dockus-storage
MINIO_USE_SSL=false

# Configuración del servicio de Storage
STORAGE_SIGNED_URL_TTL_SECONDS=600
STORAGE_BOOTSTRAP_ON_STARTUP=true

# ------------------------------------------------------------------------------
# 6. INTELIGENCIA ARTIFICIAL (Ollama / LLM-first Builder)
# ------------------------------------------------------------------------------
BUILDER_OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_PORT=11435

# Modelos base utilizados para aprovisionar los modelos personalizados
PLAN_BASE_MODEL=qwen2.5-coder:7b
EVAL_BASE_MODEL=deepseek-r1:7b

# Nombres de los modelos personalizados (creados por ollama-bootstrap.mjs)
BUILDER_OLLAMA_PLAN_MODEL=dockus-builder-plan
BUILDER_OLLAMA_EVAL_MODEL=dockus-builder-eval

# Configuración de Ollama (GPU/Contexto)
OLLAMA_NUM_CTX=16384
OLLAMA_NVIDIA_VISIBLE_DEVICES=all
OLLAMA_NVIDIA_DRIVER_CAPABILITIES=compute,utility

# Parámetros del Evaluador
BUILDER_OLLAMA_TIMEOUT_MS=600000
BUILDER_LLM_ASSIST_ENABLED=true
BUILDER_SELF_HEAL_MAX_ATTEMPTS=3

# ------------------------------------------------------------------------------
# 7. RUNTIME DE EJECUCIÓN (Docker / Ephemeral Environments)
# ------------------------------------------------------------------------------
DOCKER_HOST=unix:///var/run/docker.sock

# Runtime de aislamiento (runc para dev, runsc/gvisor para prod)
BUILDER_DOCKER_RUNTIME=runc

# Prefijos para redes virtuales aisladas
BUILDER_WORKSPACE_NETWORK_PREFIX=dockus-workspace
BUILDER_EXECUTION_NETWORK_PREFIX=dockus-run

# Timeouts y Límites de Ejecución
BUILDER_DOCKER_BUILD_TIMEOUT_MS=300000
BUILDER_BATCH_TIMEOUT_SECONDS=60
BUILDER_SERVICE_READY_TIMEOUT_SECONDS=90
BUILDER_STABILITY_WINDOW_SECONDS=30

# Recolector de basura y TTL de imágenes
BUILDER_CLEANUP_IMAGES=true
BUILDER_IMAGE_TTL_MS=1800000
BUILDER_STALE_RUN_THRESHOLD_MS=600000

# Configuración de entorno base para entregas
BUILDER_DEFAULT_PYTHON_VERSION=3.11
BUILDER_BASE_PYTHON_IMAGE=python:3.11.9-slim-bookworm

# Límites de Recursos por Contenedor (Docker limits)
BUILDER_BATCH_CPU_LIMIT=0.5
BUILDER_BATCH_MEMORY_LIMIT=512m
BUILDER_SERVICE_CPU_LIMIT=0.7
BUILDER_SERVICE_MEMORY_LIMIT=768m
BUILDER_TEST_CPU_LIMIT=0.3
BUILDER_TEST_MEMORY_LIMIT=384m

# Límites de extracción y seguridad
BUILDER_MAX_EXTRACTED_FILES=1500
BUILDER_MAX_EXTRACTED_BYTES=104857600

# ------------------------------------------------------------------------------
# 8. SEMILLAS Y DATOS DE PRUEBA (Seeding)
# ------------------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@dockus.com
SEED_ADMIN_PASSWORD=Admin1234!

SEED_DEMO_DATA=false
SEED_DEMO_PASSWORD=Dockus1234!
