# ==========================================
# DOCKUS - ENVIRONMENT CONFIGURATION
# ==========================================

# ==========================================
# CONFIGURACION DE LA APLICACION (NestJS)
# ==========================================
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:3000/api

# ==========================================
# BASE DE DATOS (PostgreSQL)
# ==========================================
# Variables consumidas por backend/src/shared/infrastructure
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=dockus
DB_PASSWORD=tu_password_aqui
DB_NAME=dockus_db

# Puerto publicado por Docker Compose
POSTGRES_PORT=5432

# URL de conexion para TypeORM (Backend)
DATABASE_URL=postgresql://${DB_USERNAME}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# ==========================================
# CACHE (Redis)
# ==========================================
REDIS_HOST=localhost
REDIS_PORT=6379

# ==========================================
# SEGURIDAD (JWT)
# ==========================================
JWT_SECRET=tu_secreto_jwt_seguro_de_al_menos_32_chars
JWT_EXPIRES_IN=1d

# ==========================================
# ALMACENAMIENTO DE ARCHIVOS (MinIO)
# ==========================================
MINIO_ROOT_USER=dockus_admin
MINIO_ROOT_PASSWORD=tu_password_aqui
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=localhost
MINIO_BUCKET_NAME=dockus-storage
MINIO_USE_SSL=false
STORAGE_SIGNED_URL_TTL_SECONDS=600
STORAGE_BOOTSTRAP_ON_STARTUP=true

# ==========================================
# BUILDER (LLM-only para clasificación, estrategia y evaluación)
# ==========================================
# Variables de Ollama
BUILDER_OLLAMA_BASE_URL=http://localhost:11434
BUILDER_OLLAMA_MODEL=qwen2.5-coder:32b
OLLAMA_PORT=11435
BUILDER_OLLAMA_TIMEOUT_MS=120000
# Pipeline LLM canónico
BUILDER_LLM_BUILDER_ENABLED=true
BUILDER_LLM_BUILDER_MAX_INPUT_CHARS=35000
BUILDER_LLM_EVALUATION_MAX_INPUT_CHARS=35000

# Variables builder
BUILDER_DOCKER_BUILD_TIMEOUT_MS=300000
BUILDER_KUBECTL_TIMEOUT_MS=90000
BUILDER_CLEANUP_IMAGES=true
BUILDER_IMAGE_TTL_MS=1800000
BUILDER_STALE_RUN_THRESHOLD_MS=600000
BUILDER_DEFAULT_PYTHON_VERSION=3.11
BUILDER_BASE_PYTHON_IMAGE=python:3.11.9-slim-bookworm
BUILDER_KIND_CLUSTER_NAME=dockus-builder
BUILDER_K8S_NAMESPACE_PREFIX=dockus-run
BUILDER_BATCH_TIMEOUT_SECONDS=60
BUILDER_SERVICE_READY_TIMEOUT_SECONDS=90
BUILDER_STABILITY_WINDOW_SECONDS=30
BUILDER_MAX_EXTRACTED_FILES=1500
BUILDER_MAX_EXTRACTED_BYTES=104857600
BUILDER_PROMPT_MAX_CHARS=180000
BUILDER_BATCH_CPU_REQUEST=100m
BUILDER_BATCH_MEMORY_REQUEST=128Mi
BUILDER_BATCH_CPU_LIMIT=500m
BUILDER_BATCH_MEMORY_LIMIT=512Mi
BUILDER_SERVICE_CPU_REQUEST=150m
BUILDER_SERVICE_MEMORY_REQUEST=192Mi
BUILDER_SERVICE_CPU_LIMIT=700m
BUILDER_SERVICE_MEMORY_LIMIT=768Mi
BUILDER_TEST_CPU_REQUEST=100m
BUILDER_TEST_MEMORY_REQUEST=128Mi
BUILDER_TEST_CPU_LIMIT=300m
BUILDER_TEST_MEMORY_LIMIT=384Mi
