# ==========================================
# EDUCODEAI - ENVIRONMENT CONFIGURATION
# Root env consumed by Docker Compose and the backend.
# ==========================================

# ==========================================
# APLICACION
# ==========================================
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:3000/api

# ==========================================
# SEED
# ==========================================
SEED_ADMIN_EMAIL=admin@educodeai.com
SEED_ADMIN_PASSWORD=Admin1234!
SEED_DEMO_DATA=false
SEED_DEMO_PASSWORD=EduCodeAI1234!

# ==========================================
# POSTGRESQL
# ==========================================
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=educodeai
DB_PASSWORD=educodeai_pass
DB_NAME=educodeai_db
POSTGRES_PORT=5432
# Pool de conexiones, POR PROCESO. La API y el worker abren cada uno el suyo.
# Con varias replicas de API, replicas x DB_POOL_MAX no debe superar el
# max_connections del servidor de PostgreSQL (100 por defecto).
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=5000
# Aborta en el servidor toda consulta que exceda este tiempo, para que una
# consulta sin acotar no retenga su conexion indefinidamente.
DB_STATEMENT_TIMEOUT_MS=15000
# En Docker Compose API y worker dejan la sincronización desactivada. Para una BD de
# desarrollo desechable, puede activarse manualmente con DB_SYNCHRONIZE=true en la API.
#
# Aplica las migraciones pendientes al arrancar. Dejar en false si hay varias
# replicas de API: con todas migrando a la vez se abre una carrera sobre el
# mismo esquema. En ese caso, ejecutar `npm run migration:run` como paso previo
# del despliegue.
DB_RUN_MIGRATIONS=false
DATABASE_URL=postgresql://${DB_USERNAME}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# ==========================================
# REDIS
# ==========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=educodeai_example_jwt_secret_replace_before_prod_2026

# ==========================================
# JWT
# ==========================================
JWT_SECRET=educodeai_example_jwt_secret_replace_before_prod_2026
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=educodeai_example_refresh_secret_replace_before_prod_2026
JWT_REFRESH_EXPIRES_IN=7d
# Vida de la cache que evita un SELECT a `users` en cada peticion autenticada.
# Las mutaciones de cuenta (rol, estado, baja, restauracion) invalidan la
# entrada al instante; este TTL es solo la red de seguridad. `0` la desactiva.
AUTH_IDENTITY_CACHE_TTL_SECONDS=30

# Cuota de gasto en inferencia por proyecto, en USD. Se comprueba AL ENCOLAR:
# agotada, se rechazan las nuevas ejecuciones indicando lo gastado. 0 = sin tope.
BUILDER_PROJECT_SPEND_QUOTA_USD=0
# Cortacircuitos por proveedor de LLM. Tras N fallos de DISPONIBILIDAD (429,
# 5xx, conectividad) en la ventana, el proveedor queda en cuarentena y el
# despachador prueba el siguiente proveedor configurado. 0 = desactivado.
LLM_CIRCUIT_BREAKER_THRESHOLD=5
LLM_CIRCUIT_BREAKER_WINDOW_SECONDS=60
LLM_CIRCUIT_BREAKER_COOLDOWN_SECONDS=120

# ==========================================
# MINIO / STORAGE
# ==========================================
MINIO_ROOT_USER=educodeai_admin
MINIO_ROOT_PASSWORD=educodeai_secret_key
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=localhost
MINIO_BUCKET_NAME=educodeai-storage
MINIO_USE_SSL=false
STORAGE_SIGNED_URL_TTL_SECONDS=600
STORAGE_BOOTSTRAP_ON_STARTUP=true
# Caducidad de la evidencia generada por el pipeline, en dias. 0 la desactiva.
# Las entregas del alumno NO caducan: su borrado es una decision academica.
#
# IMPORTANTE: el backend NO aplica esta regla, solo COMPRUEBA que exista y avisa
# si falta. La version desplegada de MinIO rechaza la operacion de escritura del
# SDK (exige Content-Md5), asi que la regla se fija con el cliente `mc` como
# PASO DE DESPLIEGUE, una sola vez por bucket:
#
#   mc alias set educodeai http://<host>:9000 "$MINIO_ROOT_USER" "$MINIO_ROOT_PASSWORD"
#   mc ilm rule add educodeai/educodeai-storage --prefix "runs/" --expire-days 90
#   mc ilm rule ls educodeai/educodeai-storage      # comprobar
#
# El prefijo es `runs/` porque es donde vive la evidencia. NO usar `evidence/`:
# ese prefijo no existe y la regla no caducaria nada.
STORAGE_EVIDENCE_RETENTION_DAYS=90

# ==========================================
# AMAZON BEDROCK / BUILDER LLM
# ==========================================
# AWS credentials — omit if using IAM role or instance profile
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=   # optional: for temporary credentials

# Master key (>=32 chars) used to encrypt at rest the API keys of the LLM
# providers configured from the "Modelos de IA" tab. Without it, the backend
# refuses to store provider API keys (Bedrock/Ollama still work: no key needed).
LLM_CREDENTIALS_SECRET=

# Bedrock model IDs per builder stage (default: Qwen3-Coder-480B)
BUILDER_BEDROCK_PLAN_MODEL_ID=anthropic.claude-3-5-haiku-20241022-v1:0
BUILDER_BEDROCK_FACTS_MODEL_ID=anthropic.claude-3-5-haiku-20241022-v1:0
BUILDER_BEDROCK_EVALUATION_MODEL_ID=anthropic.claude-sonnet-4-20250514-v1:0
BUILDER_BEDROCK_QUALITY_MODEL_ID=anthropic.claude-sonnet-4-20250514-v1:0
BUILDER_BEDROCK_CHAT_MODEL_ID=anthropic.claude-sonnet-4-20250514-v1:0

# Retry policy for AWS Bedrock (exponential backoff)
BUILDER_BEDROCK_MAX_ATTEMPTS=3
BUILDER_BEDROCK_RETRY_BASE_DELAY_MS=250

BUILDER_LLM_PLAN_MAX_INPUT_CHARS=15000
BUILDER_LLM_FACTS_MAX_INPUT_CHARS=18000
BUILDER_LLM_EVAL_MAX_INPUT_CHARS=15000

# ==========================================
# BUILDER DOCKER RUNTIME
# ==========================================
# Socket del Daemon Docker. Obligatorio para el proceso worker de evaluación.
DOCKER_HOST=unix:///var/run/docker.sock
# Development default. Production should override this to runsc.
BUILDER_DOCKER_RUNTIME=runc
BUILDER_DOCKER_BUILD_TIMEOUT_MS=300000
BUILDER_CLEANUP_IMAGES=true
BUILDER_IMAGE_TTL_MS=1800000              # TTL de imagenes de entorno; la poda corre cada 30 min en el worker
# Umbral de deteccion de runs huerfanos. Lo leen DOS sitios que deben coincidir:
# el barrido de recuperacion y el `lockDuration` de BullMQ. Minimo 60000; por
# debajo, el cerrojo venceria a mitad de una evaluacion real y BullMQ reencolaria
# un job cuyo run sigue vivo, duplicando ejecucion y llamadas al LLM facturadas.
BUILDER_STALE_RUN_THRESHOLD_MS=600000
# Evaluaciones simultaneas por worker. Cada unidad es un contenedor con su
# limite de memoria y un workspace en tmpfs: subirlo consume RAM del anfitrion.
BUILDER_WORKER_CONCURRENCY=5
BUILDER_MAX_EXTRACTED_FILES=1500
BUILDER_MAX_EXTRACTED_BYTES=104857600
BUILDER_PROMPT_VERSION=2026.07-chain-of-verification
# Limites del contenedor que ejecuta codigo del alumno. BUILDER_EXEC_PIDS_LIMIT
# acota las fork bombs: sin el, agotar los PIDs del anfitrion es trivial.
BUILDER_BATCH_CPU_LIMIT=0.5
BUILDER_BATCH_MEMORY_LIMIT=512m
BUILDER_EXEC_PIDS_LIMIT=256

