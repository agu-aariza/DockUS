# ==========================================
# DOCKUS - ENVIRONMENT CONFIGURATION
# ==========================================

# ==========================================
# CONFIGURACIÓN DE LA APLICACIÓN (NestJS)
# ==========================================
PORT=3000

# ==========================================
# BASE DE DATOS (PostgreSQL)
# ==========================================
# Credenciales para levantar el contenedor Docker
POSTGRES_USER=dockus
POSTGRES_PASSWORD=dockus_secret
POSTGRES_DB=dockus_db
POSTGRES_PORT=5432

# URL de conexión para TypeORM (Backend)
DATABASE_URL=postgresql://dockus:dockus_secret@localhost:5432/dockus_db

# ==========================================
# CACHÉ (Redis)
# ==========================================
REDIS_HOST=localhost
REDIS_PORT=6379

# ==========================================
# SEGURIDAD (JWT)
# ==========================================
JWT_SECRET=reemplazar_por_un_secreto_seguro_en_produccion
JWT_EXPIRATION=1d

# ==========================================
# ALMACENAMIENTO DE ARCHIVOS (MinIO)
# ==========================================
MINIO_ROOT_USER=dockus_admin
MINIO_ROOT_PASSWORD=dockus_secret_key
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=localhost