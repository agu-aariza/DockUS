# eslint-plugin-jsx-a11y@6.10.2 (última publicada) declara un rango de peers que
# se detiene en eslint@9, pero funciona con eslint@10 en flat config — que es lo
# que usa este paquete. Sin esto, `npm ci` aborta con ERESOLVE y el CI no arranca.
# Revisar cuando jsx-a11y publique soporte de eslint@10.
legacy-peer-deps=true
